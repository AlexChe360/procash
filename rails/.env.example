# Automatically loaded in development by dotenv-rails.
# Rails databases only. Do not point at the live Rust database.
PROCASH_DB_HOST=127.0.0.1
PROCASH_DB_PORT=55439
PROCASH_DB_USER=procash_rails
PROCASH_DB_PASSWORD=
APP_ORIGIN=http://localhost:3101
APP_HOST=localhost
PORT=3101
# Set independently through ENV or a secret manager; never commit real values.
SECRET_KEY_BASE=
PROCASH_ENCRYPTION_KEY_V1=
INVITATION_TOKEN_SECRET=
IIKO_APP_ID=
IIKO_CLIENT_SECRET=
# Uncomment SMTP_MODE only after filling all SMTP fields.
# starttls: 587; tls: 465.
# SMTP_MODE=local
# SMTP_HOST=127.0.0.1
# SMTP_FROM=mail@example.test
# SMTP_TO=admin@example.test
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Optional local documentation assistant. Keep the model API on a private network.
AI_ASSISTANT_ENABLED=0
