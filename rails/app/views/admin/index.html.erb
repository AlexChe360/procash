<h1>Обзор ProCash</h1><p class="muted">Подключение ресторанов</p><div class="grid"><section class="card"><h2>Новые заявки</h2><div class="metric"><%= ConnectionRequest.where(status: "new").count %></div></section><section class="card"><h2>На рассмотрении</h2><div class="metric"><%= ConnectionRequest.where(status: "in_review").count %></div></section><section class="card"><h2>Компании</h2><div class="metric"><%= @merchant_count %></div></section></div><%= render "activity" %><div class="admin-overview-links"><a class="button" href="/demo/requests">Открыть заявки →</a><a class="button secondary" href="/demo/merchants">Открыть компании →</a></div>