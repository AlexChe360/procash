<% if flash[:notice] %><p class="outlet-success" role="status"><%= flash[:notice] %></p><% end %>
<% if flash[:alert] %><p class="error" role="alert"><%= flash[:alert] %></p><% end %>
<a class="muted" href="/demo/requests">← Заявки</a><section class="card"><h1><%= @connection_request.establishment_name %></h1><p><span class="badge"><%= @connection_request.status %></span></p><p><%= @connection_request.contact_name %> · <%= @connection_request.contact_email %> · <%= @connection_request.contact_phone %></p><p>БИН/ИИН: <%= @connection_request.bin_iin.presence || @connection_request.merchant&.bin_iin.presence || "Не указан" %></p><p><%= @connection_request.city %> · <%= @connection_request.pos_system %></p><p><%= @connection_request.comment %></p><div class="actions"><% if @connection_request.status == "new" %><%= button_to "Взять в работу", "/demo/requests/#{@connection_request.id}/review" %><% elsif @connection_request.status == "in_review" %><%= button_to "Одобрить", "/demo/requests/#{@connection_request.id}/decision/approve" %><%= button_to "Отклонить", "/demo/requests/#{@connection_request.id}/decision/reject" %><% end %></div></section><% if @connection_request.status == "approved" %><section class="card"><% if @connection_request.merchant_id %><h2><%= @connection_request.merchant.legal_name %></h2><%= render "invitation_status" %><% else %><h2>Создать компанию</h2><%= form_with url: "/demo/requests/#{@connection_request.id}/merchant" do %><label>Юридическое наименование<%= text_field_tag :legal_name, nil, required: true %></label><label>БИН/ИИН<%= text_field_tag :bin_iin, @connection_request.bin_iin, required: true, pattern: "[0-9]{12}" %></label><%= submit_tag "Создать компанию" %><% end %><% end %></section><% end %>
