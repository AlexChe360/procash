<% base = "/dashboard/merchants/#{@merchant.id}/outlets/#{@outlet.id}" %>
<div class="outlet-page"><%= render "pos_configurations/shared/heading", step: 3, title: "Сопоставьте столы" %>
<% unless @outlet.outlet_iiko_setting&.is_enabled %><%= render "pos_configurations/shared/activation_warning", activation_url: "#{base}?tab=pos#iiko-step-4" %><% end %>
<section class="outlet-panel"><div class="outlet-panel-heading"><div><h2>Столы ProCash → iiko</h2><p>Для каждого стола выберите соответствующий стол кассовой системы и сохраните сопоставление.</p></div><a class="button outlet-secondary" href="<%= base %>?tab=tables">Добавить столы</a></div>
<% if @tables.empty? %><div class="outlet-empty"><h3>В точке пока нет столов</h3><p>Сначала создайте столы в ProCash, затем вернитесь к сопоставлению.</p><a class="button" href="<%= base %>?tab=tables">Добавить первый стол →</a></div>
<% elsif @data[:tables].empty? %><p class="error">iiko не вернул столы выбранной терминальной группы. Проверьте выбор группы и настройки столов в iiko.</p><a href="<%= base %>?tab=pos#iiko-step-2">Вернуться к выбору организации →</a>
<% else %><% @tables.each do |table| %><div class="iiko-mapping-row"><div><strong><%= table.name %></strong><span class="muted">Код <%= table.code %></span><% selected = @data[:tables].find { |item| item["id"] == table.pos_table_id } %><% if selected %><small class="iiko-mapped-status">✓ Сохранено: <%= selected["sectionName"] %> · <%= (selected["displayName"] || selected["name"]) %></small><% elsif table.pos_table_id.present? %><small class="error">Ранее выбранный стол больше не доступен. Выберите другой.</small><% end %></div><%= form_with url: "#{request.path}/#{table.id}/link", class: "outlet-form" do %><label for="iiko-table-<%= table.id %>" class="iiko-sr-only">Стол iiko для <%= table.name %></label><%= render "shared/select", name: :iiko_table_id, id: "iiko-table-#{table.id}", label: "Стол iiko для #{table.name}", placeholder: "Выберите стол iiko", options: options_for_select(@data[:tables].map { |item| ["#{item['sectionName']} · #{item['displayName'] || item['name']}", item['id'], { "data-group" => item['sectionName'] }] }, table.pos_table_id) %><%= submit_tag "Сохранить" %><% end %></div><% end %><% end %>
</section>
<% if @tables.any? { |table| table.pos_table_id.present? } %><div class="iiko-next-step"><p>Сопоставления сохраняются отдельно для каждого стола.</p><a class="button" href="<%= base %>?tab=pos#iiko-step-4">Перейти к активации →</a></div><% end %></div>
