<div class="outlet-page"><%= render "pos_configurations/shared/heading", step: 2, title: "Организация и терминальная группа" %>
<div class="outlet-columns"><section class="outlet-panel"><div class="outlet-panel-heading"><div><h2>1. Выберите организацию</h2><p>Используется подключение «<%= @data[:connection].name %>».</p></div><span class="outlet-pill is-enabled">Ключ проверен</span></div>
<%= form_with url: request.path, method: :get, class: "outlet-form" do %><div class="pc-select-field"><label for="organization_id">Организация iiko</label><%= render "shared/select", name: :organization_id, id: "organization_id", label: "Организация iiko", placeholder: "Выберите организацию", options: options_for_select(@data[:organizations].map { |org| [org["name"], org["id"]] }, @data[:organization_id]) %></div><%= submit_tag "Загрузить терминальные группы" %><% end %>
<% if @data[:organizations].empty? %><p class="error">Нет доступных организаций. Проверьте права API-ключа в iiko.</p><% end %></section>
<section class="outlet-panel"><div class="outlet-panel-heading"><div><h2>2. Выберите терминальную группу</h2><p>После выбора нажмите «Сохранить и продолжить».</p></div></div>
<% if @data[:groups].any? %><%= form_with url: request.path.sub(/setup$/, "binding"), class: "outlet-form" do %><%= hidden_field_tag :organization_id, @data[:organization_id] %><div class="pc-select-field"><label for="terminal_group_id">Терминальная группа</label><%= render "shared/select", name: :terminal_group_id, id: "terminal_group_id", label: "Терминальная группа", placeholder: "Выберите терминальную группу", options: options_for_select(@data[:groups].map { |group| [group["name"], group["id"]] }, @data[:selected_terminal_group_id]) %></div><p class="iiko-form-note">Сохраним выбор и перейдём к столам. Интеграция пока останется выключенной.</p><%= submit_tag "Сохранить и продолжить →" %><% end %>
<% else %><div class="outlet-empty"><h3><%= @data[:organization_id].present? ? "Терминальные группы не найдены" : "Сначала выберите организацию" %></h3><p><%= @data[:organization_id].present? ? "Проверьте терминальные группы этой организации в iiko или выберите другую организацию." : "После загрузки здесь появятся доступные группы." %></p></div><% end %></section></div></div>
