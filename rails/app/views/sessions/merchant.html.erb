<% error = @error; csrf_token = form_authenticity_token %>

<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <meta name="referrer" content="origin">

    <title>Вход в кабинет — ProCash</title>

    <link rel="stylesheet"
          href="/static/css/tailwind.css">
</head>

<body class="min-h-screen bg-white font-sans text-slate-900 antialiased">

<div class="grid min-h-screen min-w-0 lg:grid-cols-2">

    <!-- LEFT PROMO PANEL -->
    <aside class="relative hidden overflow-hidden bg-slate-950 text-white lg:flex lg:flex-col lg:justify-between lg:p-12 xl:p-16">

        <!-- BACKGROUND -->
        <div class="pointer-events-none absolute -right-40 -top-40 h-96 w-96 rounded-full bg-amber-400/10 blur-3xl"></div>

        <div class="pointer-events-none absolute -bottom-52 -left-40 h-[500px] w-[500px] rounded-full bg-slate-700/30 blur-3xl"></div>

        <!-- LOGO -->
        <a href="/"
           class="relative z-10 inline-flex w-fit items-center text-3xl font-extrabold tracking-tight">

            Pro<span class="text-amber-400">Cash</span>

        </a>

        <!-- PROMO CONTENT -->
        <div class="relative z-10 max-w-xl">

            <span class="text-xs font-bold uppercase tracking-[0.25em] text-amber-400">
                ProCash Business
            </span>

            <h1 class="mt-8 text-5xl font-bold leading-[1.15] tracking-tight xl:text-6xl">

                Ваш бизнес.

                <span class="block text-amber-400">
                    Ваши платежи.
                </span>

                Один кабинет.

            </h1>

            <p class="mt-8 max-w-md text-lg leading-8 text-slate-400">
                Управляйте заведениями,
                отслеживайте подключения
                и работайте с ProCash
                в едином интерфейсе.
            </p>

            <!-- FEATURES -->
            <div class="mt-12 space-y-5">

                <div class="flex items-center gap-4">

                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/10 text-amber-400">

                        <svg class="h-5 w-5"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <path d="M3 10h18l-2-7H5l-2 7Z"/>
                            <path d="M3 10v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-9"/>
                            <path d="M9 21v-8h6v8"/>

                        </svg>

                    </span>

                    <span class="text-sm font-medium text-slate-300">
                        Управление торговыми точками
                    </span>

                </div>

                <div class="flex items-center gap-4">

                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/10 text-amber-400">

                        <svg class="h-5 w-5"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <rect x="3" y="5" width="18" height="14" rx="2"/>
                            <path d="M3 10h18"/>
                            <path d="M7 15h4"/>

                        </svg>

                    </span>

                    <span class="text-sm font-medium text-slate-300">
                        Подключение банковского эквайринга
                    </span>

                </div>

                <div class="flex items-center gap-4">

                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/10 text-amber-400">

                        <svg class="h-5 w-5"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <rect x="3" y="3" width="7" height="7" rx="1"/>
                            <rect x="14" y="3" width="7" height="7" rx="1"/>
                            <rect x="3" y="14" width="7" height="7" rx="1"/>
                            <path d="M14 14h3v3h-3zM21 14v3M17 21h4M14 21v-2"/>

                        </svg>

                    </span>

                    <span class="text-sm font-medium text-slate-300">
                        QR-оплата и POS-интеграции
                    </span>

                </div>

            </div>

        </div>

        <!-- FOOTER -->
        <div class="relative z-10 flex items-center justify-between text-xs text-slate-500">

            <span>© 2026 ProCash</span>

            <span>Business Platform</span>

        </div>

    </aside>

    <!-- RIGHT LOGIN PANEL -->
    <main class="flex min-h-screen flex-col bg-white">

        <!-- MOBILE HEADER -->
        <div class="flex items-center justify-between border-b border-slate-100 px-6 py-5 lg:hidden">

            <a href="/">
                <img src="/assets/procash-logo.png"
                     alt="ProCash"
                     class="h-10 w-auto max-w-36 object-contain">
            </a>

            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                Business
            </span>

        </div>

        <!-- LOGIN CONTAINER -->
        <div class="flex flex-1 items-center justify-center px-6 py-12 sm:px-10 lg:px-16">

            <div class="w-full max-w-md">

                <!-- DESKTOP LOGO -->
                <a href="/"
                   class="mb-12 hidden w-fit lg:block">

                    <img src="/assets/procash-logo.png"
                         alt="ProCash"
                         class="h-12 w-auto max-w-44 object-contain">

                </a>

                <!-- HEADING -->
                <div class="mb-9">

                    <span class="text-xs font-bold uppercase tracking-[0.2em] text-amber-600">
                        Личный кабинет
                    </span>

                    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
                        С возвращением!
                    </h2>

                    <p class="mt-4 text-sm leading-6 text-slate-500">
                        Введите данные своей учётной записи,
                        чтобы войти в ProCash Business.
                    </p>

                </div>

                <!-- ERROR -->
                <% if (message = error) %>

                <div role="alert"
                     class="mb-7 rounded-xl border border-red-200 bg-red-50 px-5 py-4 text-sm leading-6 text-red-700">

                    <%= message %>

                </div>

                <% end %>

                <!-- LOGIN FORM -->
                <form method="post"
                      action="/login"
                      class="space-y-6">

                    <input type="hidden"
                           name="authenticity_token"
                           value="<%= csrf_token %>">

                    <!-- EMAIL -->
                    <div>

                        <label for="email"
                               class="mb-2 block text-sm font-semibold text-slate-700">
                            Email
                        </label>

                        <input type="email"
                               id="email"
                               name="email"
                               autocomplete="username"
                               inputmode="email"
                               placeholder="name@company.kz"
                               maxlength="254"
                               required
                               class="block w-full rounded-xl border border-slate-200 bg-white px-4 py-3.5 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-amber-500 focus:ring-4 focus:ring-amber-500/10 box-border min-w-0 max-w-full">

                    </div>

                    <!-- PASSWORD -->
                    <div>

                        <label for="password"
                               class="mb-2 block text-sm font-semibold text-slate-700">
                            Пароль
                        </label>

                        <input type="password"
                               id="password"
                               name="password"
                               autocomplete="current-password"
                               placeholder="Введите пароль"
                               required
                               class="block w-full rounded-xl border border-slate-200 bg-white px-4 py-3.5 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-amber-500 focus:ring-4 focus:ring-amber-500/10 box-border min-w-0 max-w-full">

                    </div>

                    <!-- SUBMIT -->
                    <button type="submit"
                            class="flex w-full items-center justify-center gap-2 rounded-xl bg-slate-950 px-5 py-4 text-sm font-bold text-white transition hover:bg-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500">

                        Войти в кабинет

                        <svg class="h-4 w-4"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <path d="M5 12h14"/>
                            <path d="m13 6 6 6-6 6"/>

                        </svg>

                    </button>

                </form>

                <!-- CONNECT -->
                <div class="mt-9 border-t border-slate-100 pt-7">

                    <p class="text-center text-sm text-slate-500">

                        Хотите подключить ресторан?

                        <a href="/connect"
                           class="ml-1 font-semibold text-amber-700 transition hover:text-amber-600 hover:underline">
                            Оставить заявку
                        </a>

                    </p>

                </div>

            </div>

        </div>

        <!-- RIGHT FOOTER -->
        <footer class="px-6 py-6 text-center text-xs text-slate-400">
            © 2026 ProCash. Все права защищены.
        </footer>

    </main>

</div>

</body>
</html>
