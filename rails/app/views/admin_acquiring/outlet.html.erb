<div class="outlet-page"><a href="/admin/acquiring" class="muted">← Эквайринг</a><h1><%= @outlet.name %></h1><p class="muted"><%= @outlet.merchant.legal_name %> · Сохранённые реквизиты</p>
<% if flash[:notice] %><p class="outlet-success" role="status"><%= flash[:notice] %></p><% end %><% if flash[:alert] %><p class="error" role="alert"><%= flash[:alert] %></p><% end %>
<% @connections.each do |connection| %><section class="card"><h2><%= connection.name %></h2><p><%= connection.provider_name %> · <%= connection.environment_label %> · <%= connection.status_label %></p><%= render "acquiring_connections/form", connection: connection, url: "/admin/acquiring/outlets/#{@outlet.id}/connections/#{connection.id}", suffix: connection.id %><div class="actions"><%= button_to(connection.disabled? ? "Восстановить" : "Отключить", "/admin/acquiring/outlets/#{@outlet.id}/connections/#{connection.id}/toggle", params: { operation: connection.disabled? ? "restore" : "disable" }, class: "outlet-secondary") %></div></section><% end %></div>
