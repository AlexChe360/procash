<% path = "/admin/acquiring/requests/#{@item.id}" %>
<div class="outlet-page"><div class="outlet-breadcrumb"><a href="/admin/acquiring">← Заявки на эквайринг</a></div>
<% if flash[:notice] %><p class="outlet-success" role="status"><%= flash[:notice] %></p><% end %><% if flash[:alert] %><p class="error" role="alert"><%= flash[:alert] %></p><% end %>
<section class="card"><h1><%= @outlet.name %></h1><p class="muted"><%= @item.merchant.legal_name %> · БИН/ИИН <%= @item.merchant.bin_iin %></p><p><%= @item.provider_name %> · <span class="badge"><%= @item.status_label %></span></p><p class="muted">Контакт: <%= @item.requester.display_name.presence || @item.requester.email %> · <%= @item.requester.email %></p><% if @item.review_note.present? %><p><%= @item.review_note %></p><% end %><% if @item.status == "pending" %><%= button_to "Взять в работу", "#{path}/review" %><% end %></section>
<% unless @item.status == "rejected" %><section class="card"><h2>Реквизиты провайдера</h2><p class="muted">Доступны только администратору ProCash. Смена реквизитов возвращает заявку на рассмотрение.</p>
<%= form_with url: "#{path}/configure", class: "outlet-form" do %>
<% unless @connection %><label for="existing-connection">Существующее подключение (если реквизиты уже сохранялись)</label><%= render "shared/select", name: :existing_connection_id, id: "existing-connection", label: "Существующее подключение", placeholder: "Создать новое", required: false, options: options_for_select(@connections.map { |c| ["#{c.name} · #{c.provider_merchant_id} · #{c.environment_label}", c.id] }) %><% end %>
<label>Название подключения<%= text_field_tag :name, @connection&.name || "#{@item.provider_name} · #{@outlet.name}", required: true, maxlength: 100 %></label>
<label>Merchant ID провайдера<%= text_field_tag :provider_merchant_id, @connection&.provider_merchant_id, required: true, pattern: "[0-9]{1,64}", maxlength: 64 %></label>
<label for="admin-acquiring-mode">Режим</label><%= render "shared/select", name: :environment, id: "admin-acquiring-mode", label: "Режим подключения", placeholder: "Выберите режим", options: options_for_select([["Тестовый", "test"], ["Боевой", "live"]], @connection&.environment || "test") %>
<label>Секретный ключ для приёма платежей<%= password_field_tag :payment_secret, nil, autocomplete: "new-password", maxlength: 4096, placeholder: @connection&.secret_saved? ? "Оставьте пустым, чтобы сохранить ключ" : "Ключ из кабинета провайдера" %></label><p class="muted"><%= @connection&.secret_saved? ? "Ключ зашифрован и сохранён." : "Ключ ещё не добавлен." %></p><div><%= button_tag "Сохранить реквизиты" %></div><% end %></section><% end %>
<% if @item.status.in?(%w[pending in_review]) %><section class="card"><h2>Решение по заявке</h2><p class="muted">Одобрение доступно после сохранения боевого Merchant ID и ключа. Оно не включает реальные платежи.</p><%= form_with url: "#{path}/decision" do %><label>Комментарий для мерчанта<%= text_area_tag :review_note, nil, maxlength: 1000, rows: 3, placeholder: "Для отклонения укажите причину" %></label><div class="actions"><%= button_tag "Одобрить", name: :decision, value: "approve", disabled: !(@connection && @connection.secret_saved? && !@connection.disabled? && @connection.environment == "live") %><%= button_tag "Отклонить", name: :decision, value: "reject", class: "outlet-secondary" %></div><% end %></section><% end %></div>
