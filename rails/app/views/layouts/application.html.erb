<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= content_for?(:title) ? yield(:title) : "ProCash — личный кабинет" %></title><%= csrf_meta_tags %><%= csp_meta_tag %><%= stylesheet_link_tag "application", "select", "data-turbo-track": "reload" %><%= javascript_importmap_tags %></head>
<body><header class="topbar"><a class="brand" href="/">Pro<span>Cash</span></a><nav aria-label="Основное меню"><% if current_user %><%= render "shared/navigation" %><% else %><a href="/">Главная</a><a href="/connect">Подключить ресторан</a><a href="/documentation" <%= 'aria-current="page"'.html_safe if controller_name == "documentation" %>>Документация</a><% end %></nav><div class="topbar-account"><% if current_user %><span class="topbar-email" title="<%= current_user.email %>"><% if current_user.display_name.present? %><strong><%= current_user.display_name %></strong><% end %><span><%= current_user.email %></span></span><%= button_to(current_user.admin? ? "/admin/logout" : "/dashboard/logout") do %><%= render "shared/icon", name: "logout" %><span>Выйти</span><% end %><% else %><a href="/login">Войти</a><% end %></div></header><main class="workspace"><% if @error %><p class="error" role="alert"><%= @error %></p><% end %><%= yield %></main></body></html>
