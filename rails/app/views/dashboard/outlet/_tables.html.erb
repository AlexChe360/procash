<div class="outlet-columns">
<section class="outlet-panel"><div class="outlet-panel-heading"><div><h2>Столы <span class="outlet-count"><%= @tables.size %></span></h2><p>QR-код привязан к столу и сохраняется при настройке POS.</p></div></div>
<% if @tables.empty? %><div class="outlet-empty"><span class="outlet-empty-icon">▦</span><h3>Пока нет столов</h3><p>Добавьте первый стол, чтобы получить QR-код.</p></div><% else %><div class="outlet-table-scroll"><table><thead><tr><th>Код</th><th>Название</th><th>Зона</th><th>QR-код</th></tr></thead><tbody><% @tables.each do |table| %><tr><td><span class="outlet-table-code"><%= table.code %></span></td><td><%= table.name %></td><td class="muted"><%= table.zone.presence || "—" %></td><td><div class="outlet-table-links"><a href="/t/<%= table.qr_token %>" target="_blank" rel="noopener">Счёт ↗</a><a href="<%= base %>/tables/<%= table.id %>/qr/design">Дизайн и SVG</a></div></td></tr><% end %></tbody></table></div><% end %></section>
<% if @membership.manages? %><section class="outlet-panel"><div class="outlet-panel-heading"><div><h2>Новый стол</h2><p>Код должен быть уникальным в этой точке.</p></div></div><%= form_with url: "#{base}/tables", class: "outlet-form" do %><label>Код стола<%= text_field_tag :code, params[:code], required: true, maxlength: 32, placeholder: "Например, 01" %></label><label>Название<%= text_field_tag :name, params[:name], required: true, minlength: 2, maxlength: 120, placeholder: "Стол у окна" %></label><label>Зона <span class="muted">необязательно</span><%= text_field_tag :zone, params[:zone], maxlength: 100, placeholder: "Основной зал" %></label><%= submit_tag "Добавить стол" %><% end %></section><% end %>
</div>

<% if @membership.manages? && @outlet.pos_system == "iiko" && @tables.any? %><% binding = @outlet.outlet_iiko_setting %><div class="iiko-next-step"><p>Столы добавлены. Следующий шаг — связать их со столами iiko.</p><a class="button" href="<%= binding&.organization_id.present? && binding&.terminal_group_id.present? ? "#{base}/pos/tables" : "#{base}?tab=pos#iiko-step-2" %>">Продолжить настройку iiko →</a></div><% end %>
