<% if @outlet.pos_system == "iiko" %>
  <% wizard = IikoSetupPresenter.new(@outlet, tables: @tables) %>
  <% last_check = OutletIikoActivationCheck.find_by(outlet_id: @outlet.id) %>
  <% pos_base = "#{base}/pos" %>
  <% if !wizard.enabled? && wizard.tables_ready? %><%= render "pos_configurations/shared/activation_warning", activation_url: "#{base}?tab=pos#iiko-step-4" %><% end %>
  <section class="outlet-panel iiko-wizard-header"><div><span class="iiko-eyebrow">ПОДКЛЮЧЕНИЕ К КАССЕ</span><h2>Настройка iiko</h2><p><%= wizard.enabled? ? "Интеграция включена. Гости могут просматривать счёт по QR-коду." : "Пройдите четыре шага, чтобы получать счета из iiko." %></p></div><span class="outlet-pill <%= "is-enabled" if wizard.enabled? %>"><%= wizard.enabled? ? "Активно" : "Шаг #{wizard.current_step} из 4" %></span></section>
  <ol class="iiko-stepper" aria-label="Этапы настройки iiko"><% [["API-ключ", wizard.key_ready?], ["Организация", wizard.binding_ready?], ["Столы", wizard.tables_ready?], ["Активация", wizard.enabled?]].each_with_index do |(title, done), index| %><li class="<%= done ? "is-done" : wizard.current_step == index+1 ? "is-current" : "" %>"><a href="#iiko-step-<%= index+1 %>" <% if !wizard.enabled? && wizard.current_step == index+1 %>aria-current="step"<% end %>><span><%= done ? "✓" : index+1 %></span><strong><%= title %></strong></a></li><% end %></ol>

  <section class="outlet-panel iiko-step <%= "is-current" if !wizard.enabled? && wizard.current_step == 1 %>" id="iiko-step-1"><div class="iiko-step-heading"><span class="iiko-step-number <%= "is-done" if wizard.key_ready? %>"><%= wizard.key_ready? ? "✓" : "1" %></span><div><h2>Добавьте и проверьте API-ключ</h2><p>Проверка ключа подтверждает доступ к iiko. Интеграция включается на последнем шаге.</p></div></div>
  <% if wizard.key_ready? %><details class="iiko-completed-details"><summary>«<%= wizard.connection.name %>» · API-ключ проверен <span>Управлять подключением</span></summary><% end %>
  <% wizard.connections.each do |connection| %><div class="outlet-connection"><div class="outlet-connection-heading"><strong><%= connection.name %><% if wizard.setting&.connection_id == connection.id %><small class="muted"> · Используется в этой точке</small><% end %></strong><span class="outlet-pill <%= "is-enabled" if connection.verified? %>"><%= {"draft" => "Не проверено", "verified" => "Ключ проверен", "disabled" => "Отключено"}.fetch(connection.status, connection.status) %></span></div><div class="actions"><%= button_to connection.verified? ? "Проверить повторно" : "Проверить ключ", "#{pos_base}/connections/#{connection.id}/check", class: "outlet-secondary", disabled: connection.status == "disabled" %><% if connection.verified? && connection.id != wizard.connection&.id %><a class="button outlet-secondary" href="<%= pos_base %>/connections/<%= connection.id %>/setup">Выбрать организацию →</a><% end %></div></div><% end %>
  <details class="iiko-new-connection" <%= "open" if wizard.connections.empty? %>><summary><%= wizard.connections.empty? ? "Добавить API-ключ" : "+ Добавить другое подключение" %></summary><%= form_with url: "#{pos_base}/connections", class: "outlet-form" do %><div class="field-grid"><label>Название подключения<%= text_field_tag :name, nil, required: true, minlength: 2, maxlength: 150, placeholder: "Основное подключение" %></label><label>API-ключ iiko<%= password_field_tag :api_key, nil, required: true, autocomplete: "off", placeholder: "Ключ хранится зашифрованным" %></label></div><%= submit_tag "Сохранить ключ" %><% end %></details><% if wizard.key_ready? %></details><% end %></section>

  <section class="outlet-panel iiko-step <%= "is-current" if !wizard.enabled? && wizard.current_step == 2 %>" id="iiko-step-2"><div class="iiko-step-heading"><span class="iiko-step-number <%= "is-done" if wizard.binding_ready? %>"><%= wizard.binding_ready? ? "✓" : "2" %></span><div><h2>Выберите организацию и терминальную группу</h2><p><%= wizard.binding_ready? ? "Организация и терминальная группа сохранены. Теперь добавьте и сопоставьте столы." : "Укажите, из какого заведения и терминальной группы получать счета." %></p></div></div>
  <% if wizard.key_ready? %><a class="button <%= "outlet-secondary" if wizard.binding_ready? %>" href="<%= pos_base %>/connections/<%= wizard.connection.id %>/setup"><%= wizard.binding_ready? ? "Посмотреть или изменить" : "Выбрать организацию →" %></a><% else %><p class="iiko-prerequisite">Сначала проверьте API-ключ на шаге 1.</p><% end %></section>

  <section class="outlet-panel iiko-step <%= "is-current" if !wizard.enabled? && wizard.current_step == 3 %>" id="iiko-step-3"><div class="iiko-step-heading"><span class="iiko-step-number <%= "is-done" if wizard.tables_ready? %>"><%= wizard.tables_ready? ? "✓" : "3" %></span><div><h2>Добавьте и сопоставьте столы</h2><p><% if wizard.table_count.zero? %>В этой точке пока нет столов. Добавьте их в ProCash, затем выберите соответствующие столы iiko.<% else %>Сопоставлено <strong><%= wizard.mapped_count %> из <%= wizard.table_count %></strong>. Счёт будет доступен только у сопоставленных столов.<% end %></p></div></div>
  <% if wizard.binding_ready? %><div class="actions"><a class="button <%= "outlet-secondary" if wizard.table_count.positive? %>" href="<%= base %>?tab=tables"><%= wizard.table_count.zero? ? "Добавить столы →" : "Управлять столами" %></a><% if wizard.table_count.positive? %><a class="button" href="<%= pos_base %>/tables">Сопоставить со столами iiko →</a><% end %></div><% else %><p class="iiko-prerequisite">Сначала сохраните организацию и терминальную группу на шаге 2.</p><% end %></section>

  <section class="outlet-panel iiko-step <%= "is-current" if !wizard.enabled? && wizard.current_step == 4 %>" id="iiko-step-4"><div class="iiko-step-heading"><span class="iiko-step-number <%= "is-done" if wizard.enabled? %>"><%= wizard.enabled? ? "✓" : "4" %></span><div><h2><%= wizard.enabled? ? "Интеграция активна" : "Проверьте и активируйте интеграцию" %></h2><p>Перед включением повторно проверим доступность организации и терминальной группы в iiko.</p></div></div>
  <% if last_check %><p class="<%= last_check.status == "passed" ? "outlet-success" : "error" %>">Последняя проверка: <%= last_check.status == "passed" ? "готовность подтверждена" : "не пройдена — проверьте настройки iiko" %> · <%= last_check.checked_at.in_time_zone.strftime("%H:%M") %></p><% end %>
  <% if wizard.enabled? %><p class="outlet-success">Всё готово. QR-коды доступны во вкладке «Столы и QR».</p><a class="button outlet-secondary" href="<%= base %>?tab=tables">Открыть столы и QR →</a><% else %><div class="actions"><%= button_to "Проверить готовность", "#{pos_base}/activation/check", class: "outlet-secondary", disabled: !wizard.tables_ready? %><%= button_to "Активировать интеграцию", "#{pos_base}/activation/enable", disabled: !wizard.tables_ready? %></div><% unless wizard.tables_ready? %><p class="iiko-prerequisite">Активация станет доступна после первых трёх шагов.</p><% end %><% end %></section>
<% else %><section class="outlet-panel"><div class="outlet-empty"><h2><%= @outlet.pos_system == "r_keeper" ? "Интеграция r_keeper пока недоступна" : "POS-интеграция не настроена" %></h2><p>Для этой торговой точки нет доступного подключения.</p></div></section><% end %>
