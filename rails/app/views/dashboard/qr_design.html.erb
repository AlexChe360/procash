<% palette_color = @color || { "mint" => "#16A365", "blue" => "#466DD8" }.fetch(@design, "#E66353") %>
<% qr_query = { design: @design }; qr_query[:color] = @color if @color %>
<% base = "/dashboard/merchants/#{@merchant.id}/outlets/#{@outlet.id}" %>
<div class="outlet-page" data-controller="qr-palette">
<div class="outlet-breadcrumb"><a href="<%= base %>?tab=tables">← Столы и QR</a></div>
<header class="outlet-heading"><div><h1>QR-карточка</h1><p class="muted"><%= @outlet.name %> · <%= @table.name %></p></div></header>
<% if flash[:notice] %><p class="outlet-success" role="status"><%= flash[:notice] %></p><% end %>
<div class="qr-design-grid"><section class="outlet-panel"><h2>Оформление</h2><p class="muted">По умолчанию используется текущий классический дизайн. Оформление не меняет ссылку и привязку стола.</p>
<%= form_with url: request.path, method: :get, class: "outlet-form" do %><label for="qr-design">Дизайн карточки</label><%= render "shared/select", name: :design, id: "qr-design", label: "Дизайн карточки", placeholder: "Выберите оформление", options: options_for_select(Qr::Renderer::DESIGNS.map { |key, title| [title, key] }, @design) %><div class="qr-palette"><label class="qr-custom-toggle"><%= check_box_tag :custom_color, "1", @color.present?, data: { qr_palette_target: "enabled", action: "change->qr-palette#toggle" } %>Свой акцентный цвет</label><div class="qr-palette-controls"><label class="qr-color-control"><span class="iiko-sr-only">Выбрать акцентный цвет</span><%= color_field_tag :color_picker, palette_color, data: { qr_palette_target: "picker", action: "input->qr-palette#pick" } %></label><label class="qr-hex-control"><span>HEX</span><%= text_field_tag :color, palette_color, maxlength: 7, pattern: "#[0-9a-fA-F]{6}", disabled: @color.nil?, aria: { label: "HEX-код акцентного цвета" }, data: { qr_palette_target: "hex", action: "input->qr-palette#hex" } %></label></div><div class="qr-color-swatches"><% ["#E66353", "#16A365", "#466DD8", "#8B5CF6", "#D99423", "#263341"].each do |color| %><button type="button" class="qr-color-swatch" style="--swatch:<%= color %>" aria-label="Цвет <%= color %>" aria-pressed="false" data-color="<%= color %>" data-action="qr-palette#swatch"></button><% end %></div><small class="muted">Цвет меняет акценты и рамку. QR-код остаётся чёрным на белом.</small></div><div><%= button_tag "Применить" %></div><% end %>
<% if @membership.manages? %><section class="qr-logo-settings"><h3>Логотип</h3><p class="muted">По умолчанию — ProCash. Свой логотип применяется ко всем QR-карточкам этой точки.</p>
<%= form_with url: "#{base}/tables/#{@table.id}/qr/logo", multipart: true, class: "outlet-form" do %><%= hidden_field_tag :design, @design %><%= hidden_field_tag :color, @color, data: { qr_palette_target: "savedColor" } %><div class="qr-file-picker" data-controller="file-picker"><span class="qr-file-label">Загрузить логотип</span><div class="qr-file-row"><label class="qr-file-button"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/></svg><span>Выбрать PNG</span><%= file_field_tag :logo, accept: "image/png", required: true, class: "qr-file-input", aria: { label: "Выбрать PNG-логотип" }, data: { file_picker_target: "input", action: "change->file-picker#update" } %></label><span class="qr-file-name" data-file-picker-target="name" aria-live="polite">Файл не выбран</span></div></div><small class="muted">PNG, до 500 КБ и 2000 × 2000 пикселей. Лучше с прозрачным фоном.</small><div><%= button_tag "Сохранить логотип", class: "outlet-secondary" %></div><% end %>
<% if @outlet.qr_logo.present? %><%= button_to "Вернуть ProCash", "#{base}/tables/#{@table.id}/qr/logo", params: { reset_logo: "1", design: @design, color: @color }, class: "outlet-secondary" %><% end %></section><% end %>
<div class="qr-download-actions"><a class="button" href="<%= base %>/tables/<%= @table.id %>/qr.svg?<%= qr_query.merge(download: "1").to_query %>" data-qr-palette-target="svg" data-turbo="false">Скачать SVG</a></div><p class="muted">Векторный формат — сохраняет чёткость при масштабировании.</p></section>
<section class="qr-card-preview" aria-label="Предпросмотр QR-карточки"><img src="<%= base %>/tables/<%= @table.id %>/qr.svg?<%= qr_query.to_query %>" alt="QR-карточка <%= @table.name %>" data-qr-palette-target="preview" data-filename="procash-table-<%= @table.code.parameterize.presence || @table.id %>-<%= @design %>.png"></section></div></div>
