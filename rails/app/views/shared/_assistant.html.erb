<% if SupportAssistant::Client.enabled? %>
<div class="pc-assistant" data-controller="assistant" data-action="keydown.esc->assistant#close">
  <button type="button" class="assistant-launcher" aria-expanded="false" aria-controls="procash-assistant-panel" data-assistant-target="launcher" data-action="assistant#toggle"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5H5l-3 2V11.5a9.5 9.5 0 1 1 19 0Z"/><path d="M8 11h.01M12 11h.01M16 11h.01"/></svg><span>AI-помощник</span></button>
  <section id="procash-assistant-panel" class="assistant-panel" role="dialog" aria-modal="false" aria-label="Помощник ProCash" data-assistant-target="panel" hidden>
    <header class="assistant-header"><div><strong>Помощник ProCash</strong><span>Ответы по документации</span></div><button type="button" aria-label="Закрыть помощника" data-action="assistant#close">×</button></header>
    <div class="assistant-messages" role="log" aria-live="polite" aria-relevant="additions text" data-assistant-target="messages"><div class="assistant-message assistant-answer">Здравствуйте! Подскажу, как настроить кабинет, подключить iiko, оформить QR или подать заявку на эквайринг.</div><div class="assistant-suggestions"><% ["Как подключить iiko?", "Почему не видно заказа по QR?", "Как подключить эквайринг?"].each do |question| %><button type="button" data-action="assistant#suggest" data-question="<%= question %>"><%= question %></button><% end %></div></div>
    <form class="assistant-form" data-action="submit->assistant#submit"><label for="assistant-question" class="assistant-sr-only">Вопрос помощнику</label><textarea id="assistant-question" name="question" rows="2" maxlength="600" placeholder="Напишите вопрос о ProCash…" required data-assistant-target="input" data-action="keydown->assistant#keydown"></textarea><button type="submit" aria-label="Отправить вопрос" data-assistant-target="send"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19 0-14m-6 6 6-6 6 6"/></svg></button></form>
    <footer class="assistant-footer">Не указывайте пароли и ключи. AI может ошибаться — <a href="/documentation">сверяйтесь с инструкцией</a>.</footer>
  </section>
</div>
<% end %>
