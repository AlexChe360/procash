#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
./bin/go mod download
./bin/go mod verify
npm ci --no-audit --no-fund
npm run build
mkdir -p .deploy/bin
./bin/go build -o .deploy/bin/procash ./cmd/procash
if [[ ! -f .env ]]; then cp .env.example .env; chmod 600 .env; fi
.deploy/bin/procash init-env .env
.deploy/bin/procash migrate
